# ~/.common_shell_aliases
# Portable aliases and functions — sourced by both .zshrc and .bashrc

# ============================================================================
# CLIPBOARD
# ============================================================================

detect_clip_command() {
    if command -v pbcopy >/dev/null 2>&1; then
        printf "pbcopy"
    elif command -v xclip >/dev/null 2>&1; then
        printf "xclip"
    elif command -v xsel >/dev/null 2>&1; then
        printf "xsel"
    elif command -v wl-copy >/dev/null 2>&1; then
        printf "wl-copy"
    else
        return 1
    fi
}

setclip() {
    local cmd
    cmd=$(detect_clip_command) || { printf "Error: no clipboard command found\n" >&2; return 1; }
    case "$cmd" in
        pbcopy)   pbcopy ;;
        xclip)    xclip -selection clipboard ;;
        xsel)     xsel --clipboard --input ;;
        wl-copy)  wl-copy ;;
    esac
}

getclip() {
    local cmd
    cmd=$(detect_clip_command) || { printf "Error: no clipboard command found\n" >&2; return 1; }
    case "$cmd" in
        pbcopy)   pbpaste ;;
        xclip)    xclip -selection clipboard -o ;;
        xsel)     xsel --clipboard --output ;;
        wl-copy)  wl-paste ;;
    esac
}

delclip() {
    local cmd
    cmd=$(detect_clip_command) || { printf "Error: no clipboard command found\n" >&2; return 1; }
    case "$cmd" in
        pbcopy)   printf "" | pbcopy ;;
        xclip)    printf "" | xclip -selection clipboard ;;
        xsel)     printf "" | xsel --clipboard --input ;;
        wl-copy)  printf "" | wl-copy ;;
    esac
}

# ============================================================================
# PROCESS / NETWORK
# ============================================================================

kill_process_by_port() {
    # Kill whatever process is listening on the given TCP port.
    #
    # Why ss-first: lsof 4.95.x on Linux misses IPv6 dual-stack LISTEN sockets
    # on newer kernels (verified on WSL2 kernel 6.18 — `lsof -i:3000` finds
    # only IPv4 ESTABLISHED clients, not the `*:` LISTEN socket; ss and fuser
    # both see it). ss is iproute2, preinstalled everywhere on Linux. lsof is
    # retained as the macOS/BSD fallback where ss isn't present.
    # SIGTERM with a short grace period before SIGKILL so child workers (e.g.
    # `next dev`) get a chance to clean up.
    if [ -z "$1" ]; then echo "No port number supplied" >&2; return 1; fi
    case "$1" in
        ''|*[!0-9]*) echo "Error: port must be numeric, got '$1'" >&2; return 1 ;;
    esac
    local port="$1" pids pid rc=0 i
    if command -v ss >/dev/null 2>&1; then
        pids=$(ss -ltnpH "sport = :$port" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u)
        if [ -z "$pids" ] && [ "$(id -u)" -ne 0 ]; then
            pids=$(sudo ss -ltnpH "sport = :$port" 2>/dev/null | grep -oE 'pid=[0-9]+' | cut -d= -f2 | sort -u)
        fi
    elif command -v lsof >/dev/null 2>&1; then
        pids=$(lsof -t -i:"$port" 2>/dev/null | sort -u)
        if [ -z "$pids" ] && [ "$(id -u)" -ne 0 ]; then
            pids=$(sudo lsof -t -i:"$port" 2>/dev/null | sort -u)
        fi
    else
        echo "Error: neither ss nor lsof available" >&2; return 1
    fi
    if [ -z "$pids" ]; then echo "No process found on port $port"; return 1; fi
    for pid in $pids; do
        if kill -TERM "$pid" 2>/dev/null; then
            i=0
            while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 10 ]; do
                sleep 0.3
                i=$((i + 1))
            done
            if kill -0 "$pid" 2>/dev/null; then
                kill -KILL "$pid" 2>/dev/null
            fi
            echo "Killed process $pid running on port $port"
        else
            echo "Error: cannot signal pid $pid (try sudo?)" >&2
            rc=1
        fi
    done
    return $rc
}

# watchcommit pause/resume + agent detection — the daemon checks a pause
# touch-file at the top of each poll tick (manual opt-in, opt-out via
# /proc agent-proc detection layered on top; see ~/.local/bin/watchcommit).
# wc-pause / wc-resume manage the touch-file so manual git history surgery
# (commit --amend, rebase, etc.) can block the daemon without SIGSTOP-ing it.
# wc-status reports pause state AND any holding agent PIDs the daemon skipped
# a tick for (read from the agents-active state file the daemon clears on a
# clean tick), plus the daemon's last known background pull/commit/push
# (last-activity.json, so daemon-driven git state changes are never mistaken
# for manual ones). State dir follows XDG_STATE_HOME (defaults to
# ~/.local/state), kept consistent with the daemon's STATE_DIR / PAUSE_FILE /
# AGENTS_STATE_FILE / ACTIVITY_STATE_FILE.
wc-pause()  { mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/watchcommit" && touch "${XDG_STATE_HOME:-$HOME/.local/state}/watchcommit/paused" && echo "watchcommit paused"; }
wc-resume() { rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/watchcommit/paused" && echo "watchcommit resumed"; }
wc-status() {
    local state="${XDG_STATE_HOME:-$HOME/.local/state}/watchcommit"
    if [ -f "${state}/paused" ]; then
        echo "watchcommit paused"
    elif [ -s "${state}/agents-active" ]; then
        echo "watchcommit agent-active (skipping ticks):"
        cat "${state}/agents-active"
    else
        echo "watchcommit running"
    fi
    if [ -f "${state}/last-activity.json" ]; then
        python3 ~/.claude/scripts/watchcommit_activity.py
    fi
}

# opencode-skills-sync pause/resume — same touch-file pattern as
# wc-pause/wc-resume/wc-status above, targeting opencode_skills_sync.py's own
# STATE_DIR/PAUSE_FILE (scripts/opencode_skills_sync.py). No agent-active or
# last-activity concepts here — this daemon doesn't have them.
oc-pause()  { mkdir -p "${XDG_STATE_HOME:-$HOME/.local/state}/opencode-skills-sync" && touch "${XDG_STATE_HOME:-$HOME/.local/state}/opencode-skills-sync/paused" && echo "opencode-skills-sync paused"; }
oc-resume() { rm -f "${XDG_STATE_HOME:-$HOME/.local/state}/opencode-skills-sync/paused" && echo "opencode-skills-sync resumed"; }
oc-status() {
    local state="${XDG_STATE_HOME:-$HOME/.local/state}/opencode-skills-sync"
    if [ -f "${state}/paused" ]; then
        echo "opencode-skills-sync paused"
    else
        echo "opencode-skills-sync running"
    fi
}

# ============================================================================
# ALIASES
# ============================================================================

# Shell config
alias vi="nvim"
alias ez="vi ~/.zshrc"
alias eb="vi ~/.common_shell_aliases"
alias ev="vi ~/.vimrc"
alias br="source ~/.bashrc && source ~/.zshrc"
alias rz="source ~/.zshrc"
alias rb=true  # fat-finger guard: 'rb' on RHEL triggers unwanted behavior

# Git
alias gs="git status"
alias gp="git pull"
alias gpu="git push"
# Navigation
alias ws="cd $HOME/Workspace"
alias cl="clear"

if command -v zoxide >/dev/null 2>&1; then
    alias cd="z"
else
    echo "warning: zoxide not installed (cd alias not set)"
fi

# File listing
if command -v eza >/dev/null 2>&1; then
    _eza_sorted() {
        local -a opts=("$@")

        # Hidden files + directories
        (( ${#${:-.*(N)}} )) && command eza -d "${opts[@]}" .*(N)

        # Visible directories
        (( ${#${:-*(N/)}} )) && command eza -d "${opts[@]}" *(N/)

        # Visible files
        (( ${#${:-*(N^/)}} )) && command eza -d "${opts[@]}" *(N^/)
    }

    alias ls="_eza_sorted --icons"
    alias ll="_eza_sorted -l -h --icons"
    alias lt="eza --tree --icons"
else
    echo "warning: eza not installed (falling back to system ls)"
    alias ls="command ls --color=auto"
    alias ll="command ls -lah --color=auto"
fi

# Enhanced viewers
if command -v bat >/dev/null 2>&1; then
    alias cat="bat"
else
    echo "warning: bat not installed (cat unchanged)"
fi

if command -v ncdu >/dev/null 2>&1; then
    alias du="ncdu"
else
    echo "warning: ncdu not installed (du unchanged)"
fi

# Clipboard
alias gc="getclip"
alias sc="setclip"

# tmux
alias t="tmux"

# Maven
alias fmt="mvn com.spotify.fmt:fmt-maven-plugin:format -Dverbose=true"
alias mci="mvn clean install"
alias mdp="mvn dependency:purge-local-repository"
alias mcd="mvn clean install -DskipTests"
alias msr="mvn spring-boot:run"
