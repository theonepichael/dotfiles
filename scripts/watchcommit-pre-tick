#!/usr/bin/env sh
# watchcommit pre-tick hook for this repo (see scripts/watchcommit.py's
# "Pre-tick hook" docstring paragraph for when it runs).
#
# Recomposes claude/global-instructions.md from agent-toolkit's current
# claude/CORE_INSTRUCTIONS.md, so an edit there reaches every harness within
# a couple of watchcommit polls instead of waiting for the next install.
# watchcommit commits whatever this writes on its next tick. Composing also
# keeps this repo's git merge driver for that file registered (with the
# interpreter chosen below), so two machines committing different
# compositions in the same poll resolve on rebase instead of stalling.
#
# The composer only ever moves the file forward along agent-toolkit's
# history: on a machine whose agent-toolkit checkout is behind, or diverged
# from, the one the committed file was composed from, it skips (exit 3),
# silently under -q -- otherwise two machines would rewrite each other's
# composition on every poll. That expected skip exits 0 here; any other
# composer failure exits nonzero, which watchcommit logs without failing
# the cycle.
set -u

# shellcheck disable=SC1007 # CDPATH= clears CDPATH for this one command so cd ignores it.
REPO="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

PYTHON=""
for candidate in python3.14 python3 python3.13 python3.12 python; do
  bin="$(command -v "$candidate" 2>/dev/null)" || continue
  if "$bin" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 12) else 1)' 2>/dev/null; then
    PYTHON="$bin"
    break
  fi
done
if [ -z "$PYTHON" ]; then
  echo "watchcommit-pre-tick: no Python 3.12+ found on PATH" >&2
  exit 1
fi

status=0
"$PYTHON" "$REPO/claude/scripts/gen_core_instructions.py" -q || status=$?
if [ "$status" -eq 3 ]; then
  exit 0
fi
exit "$status"
