[Unit]
Description=opencode-skills-sync — mirrors ~/.config/opencode/skills into git, commit-only, never pushes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/opencode-skills-sync
Restart=always
RestartSec=5
StandardOutput=append:/tmp/opencode-skills-sync.log
StandardError=append:/tmp/opencode-skills-sync.log

[Install]
WantedBy=default.target
