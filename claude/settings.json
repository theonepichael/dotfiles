{
  "permissions": {
    "allow": [
      "Bash(python3 ~/.claude/scripts/dev_status.py:*)",
      "Bash(python3 ~/.claude/scripts/grill.py:*)",
      "Bash(python3 ~/.claude/scripts/second_opinion.py:*)"
    ],
    "deny": [
      "Bash(python3 ~/.claude/scripts/dev_status.py prune:*)"
    ],
    "ask": [
      "Bash(git commit)",
      "Bash(git commit *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; [ -n \"$f\" ] || exit 0; case \"$f\" in *.py) ;; *) exit 0 ;; esac; d=$(dirname \"$f\"); while [ \"$d\" != \"/\" ] && [ ! -f \"$d/pyproject.toml\" ]; do d=$(dirname \"$d\"); done; [ -f \"$d/pyproject.toml\" ] || exit 0; ( cd \"$d\" && uv run ruff format \"$f\" >/dev/null 2>&1 && uv run ruff check --fix \"$f\" >/dev/null 2>&1 ); } || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/dev_status.py render 2>&1 || echo '[dev_status] render failed \u2014 run /dashboard to debug'"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/grill.py pending-plan --consume 2>/dev/null; true"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/dotfiles_sync_check.py 2>/dev/null"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/settings_seed_drift_check.py"
          },
          {
            "type": "command",
            "command": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && { echo; echo 'recent commits:'; git log -n 5 --oneline; } 2>/dev/null; true"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/scripts/watchcommit_activity.py 2>/dev/null"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "light-daltonized",
  "statusLine": {
    "type": "command",
    "command": "python3 ~/.claude/scripts/statusline.py",
    "refreshInterval": 60
  },
  "model": "claude-sonnet-5"
}
