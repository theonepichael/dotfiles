{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "python3 ~/.claude/scripts/*": "allow",
      "python3 ~/.claude/scripts/dev_status.py *": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git stash*": "allow",
      "git add*": "allow",
      "git restore*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git worktree*": "allow",
      "git ls-files*": "allow",
      "git check-ignore*": "allow",
      "git fetch*": "allow",
      "git clone*": "allow",
      "git mv*": "allow",
      "git --no-pager *": "allow",
      "git -C * log*": "allow",
      "git -C * status*": "allow",
      "git -C * diff*": "allow",
      "git -C * add*": "allow",
      "git -C * stash*": "allow",
      "git -C * restore*": "allow",
      "git -C * show*": "allow",
      "git -C * branch*": "allow",
      "git -C * remote*": "allow",
      "git -C * worktree*": "allow",
      "git -C * ls-files*": "allow",
      "git -C * check-ignore*": "allow",
      "git -C * fetch*": "allow",
      "git -C * mv*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm install*": "allow",
      "npm install": "allow",
      "npx *": "allow",
      "node scripts/*": "allow",
      "node -e *": "allow",
      "uv *": "allow",
      "python3 -c *": "allow",
      "python3 -m *": "allow",
      "python3 - *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "curl *": "allow",
      "lsof *": "allow",
      "ps *": "allow",
      "ls*": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "nohup *": "allow",
      "kill*": "allow",
      "sleep *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "env": "allow",
      "printenv*": "allow",
      "cat *": "allow",
      "sed -n *": "allow",
      "rm -f *": "allow",
      "sqlite3 *": "allow",
      "strings *": "allow",
      "readlink *": "allow",
      "pgrep *": "allow",
      "pkill *": "allow",
      "ss *": "allow",
      "ln *": "allow",
      "chmod *": "allow",
      "jq *": "allow",
      "diff *": "allow",
      "diff": "allow",
      "echo": "allow",
      "head": "allow",
      "tail": "allow",
      "wc": "allow",
      "sort": "allow",
      "uniq": "allow",
      "cat": "allow",
      "systemctl status*": "allow",
      "systemctl is-active*": "allow",
      "systemctl is-enabled*": "allow",
      "opencode run*": "allow",
      "copilot *": "allow"
    },
    "external_directory": {
      "~/.claude/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/dotfiles/**": "allow",
      "~/dotfiles-*/**": "allow",
      "~/Workspace/**": "allow",
      "/tmp/**": "allow",
      "/mnt/c/Users/yanil/Downloads/**": "allow",
      "/mnt/c/Users/yanil/OneDrive/Pictures/Screenshots/**": "allow"
    }
  },
  "agent": {
    "adversary": {
      "description": "Adversarial critique agent for grill-me's --auto mode and second_opinion.py's opencode backend. Argues against a proposed decision/plan using a model different from the primary session's default, so the critique is genuinely independent rather than the same model second-guessing itself. mode \"all\" (not \"subagent\") is required: opencode run --agent silently falls back to the default agent for anything marked subagent-only.",
      "mode": "all",
      "model": "opencode-go/qwen3.7-max"
    }
  }
}
