{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "python3 ~/.claude/scripts/*": "allow",
      "python3 ~/.claude/scripts/dev_status.py *": "allow",
      "git log*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git stash*": "allow",
      "git add*": "allow",
      "git restore*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "npm run*": "allow",
      "npm test*": "allow",
      "npm install*": "allow",
      "npm install": "allow",
      "npx *": "allow",
      "node scripts/*": "allow",
      "node -e *": "allow",
      "uv *": "allow",
      "curl *": "allow",
      "lsof *": "allow",
      "ps *": "allow",
      "ls*": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "nohup *": "allow",
      "kill*": "allow",
      "sleep *": "allow",
      "echo *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "file *": "allow",
      "stat *": "allow",
      "du *": "allow",
      "df *": "allow",
      "date*": "allow",
      "whoami*": "allow",
      "env": "allow",
      "printenv*": "allow",
      "cat *": "allow",
      "sed -n *": "allow",
      "awk *": "allow",
      "xargs *": "allow",
      "rm -f *": "allow"
    }
  }
}
