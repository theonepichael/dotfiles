{
  "[dockercompose]": {
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.insertSpaces": true,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true
    },
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never",
    "editor.formatOnSave": true,
    "editor.guides.indentation": true,
    "editor.wordBasedSuggestions": "off",
    "gitlens.codeLens.symbolScopes": ["!Module"]
  },
  "claudeCode.disableLoginPrompt": true,
  "editor.formatOnSave": true,
  "editor.tabCompletion": "on",
  "editor.minimap.enabled": false,
  "editor.mouseWheelZoom": true,
  "http.proxySupport": "fallback",
  "python.analysis.typeCheckingMode": "standard",
  "python.languageServer": "Pylance",
  "ty.disableLanguageServices": true,
  "remote.autoForwardPortsSource": "hybrid",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.completion.autoimport.enable": true,
  "rust-analyzer.hover.actions.references.enable": true,
  "rust-analyzer.inlayHints.parameterHints.enable": true,
  "rust-analyzer.inlayHints.typeHints.enable": true,
  "rust-analyzer.server.extraEnv": {
    "PATH": "${env:HOME}/.cargo/bin:${env:PATH}"
  },
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.integrated.copyOnSelection": true,
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontFamily": "CaskaydiaCove Nerd Font",
  "terminal.integrated.gpuAcceleration": "off",
  "vim.handleKeys": {
    "<C-b>": false,
    "<C-d>": true,
    "<C-w>": false,
    "<C-k>": false,
    "<C-s>": false,
    "<C-z>": false
  },
  "vim.highlightedyank.enable": true,
  "vim.leader": " ",
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["i", "i"],
      "commands": ["extension.vim_escape"]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "S"], "commands": ["workbench.action.showAllSymbols"] },
    { "before": ["g", "s"], "commands": ["workbench.action.findInFiles"] },
    { "before": ["g", "i"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["<leader>", "y", "a"], "commands": [":%+y"] },
    { "before": ["[", "f"], "commands": ["workbench.action.gotoSymbol"] },
    { "before": ["<leader>", "v"], "commands": ["workbench.action.splitEditor"] },
    { "before": ["<leader>", "x"], "commands": [":x <CR>"] },
    { "before": ["<leader>", "w"], "commands": ["workbench.action.files.save"] },
    { "before": ["<leader>", "u"], "commands": ["workbench.action.splitEditorDown"] },
    { "before": ["<leader>", "h"], "commands": ["workbench.action.focusLeftGroup"] },
    { "before": ["<leader>", "l"], "commands": ["workbench.action.focusRightGroup"] },
    { "before": ["<leader>", "j"], "commands": ["workbench.action.focusBelowGroup"] },
    { "before": ["<leader>", "k"], "commands": ["workbench.action.focusAboveGroup"] },
    { "after": ["z", "z"], "before": ["<leader>", "m"] },
    { "before": ["<leader>", "r"], "commands": ["workbench.action.reloadWindow"] },
    { "after": [":"], "before": [";"] },
    { "after": ["<C-d>", "z", "z"], "before": ["<C-d>"] },
    { "after": ["<C-u>", "z", "z"], "before": ["<C-u>"] },
    { "before": ["<C-l>"], "commands": ["editor.action.clearHighlights"] },
    { "before": ["<leader>", "z"], "commands": ["workbench.action.toggleMaximizedPanel"] },
    { "after": ["*", "z", "z"], "before": ["*"] },
    { "after": ["#", "z", "z"], "before": ["#"] },
    { "before": ["<leader>", "f"], "commands": ["workbench.action.nextEditor"] },
    { "before": ["<leader>", "b"], "commands": ["workbench.action.previousEditor"] },
    { "before": ["z", "c"], "commands": ["editor.fold"] },
    { "before": ["z", "o"], "commands": ["editor.unfold"] },
    { "before": ["z", "M"], "commands": ["editor.foldAll"] },
    { "before": ["z", "R"], "commands": ["editor.unfoldAll"] },
    { "before": ["z", "a"], "commands": ["editor.toggleFold"] }
  ],
  "vim.smartRelativeLine": true,
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": ["i", "i"],
      "commands": ["extension.vim_escape"]
    },
    {
      "after": ["\"", "_", "d", "P"],
      "before": ["p"]
    }
  ],
  "window.zoomLevel": 0.1,
  "workbench.panel.defaultLocation": "right",
  "workbench.colorTheme": "Catppuccin Frappé",
  "workbench.iconTheme": "vscode-icons",
  "workbench.secondarySideBar.showLabels": false,
  "workbench.activityBar.location": "top",
  "typescript.suggest.paths": true
}
